[Desktop Entry]
Type=Application
Name=Spreadsheet (Adaptive)
Comment=Edit spreadsheets (Gnumeric or LibreOffice Calc based on RAM)
Exec=/usr/local/bin/lite-launch-spreadsheet %U
Icon=gnumeric
Terminal=false
Categories=Office;Spreadsheet;
MimeType=application/vnd.ms-excel;application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;application/vnd.oasis.opendocument.spreadsheet;text/csv;
