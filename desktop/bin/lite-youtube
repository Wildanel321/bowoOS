#!/bin/bash
# ==============================================================================
# LiteOffice OS — Hardware-Accelerated YouTube & Video Launcher
# Engineered for Mini PCs with 2 CPU Cores & 2 GB RAM
# ==============================================================================
set -euo pipefail

URL="${1:-}"

if [ "$URL" = "--help" ] || [ "$URL" = "-h" ]; then
    echo "LiteOffice OS — YouTube & Video Launcher"
    echo "Usage: lite-youtube [URL]"
    echo ""
    echo "Options:"
    echo "  --help, -h   Show this help message"
    echo ""
    echo "Engineered for 2-Core / 2 GB RAM Mini PCs:"
    echo "  - Direct URLs are accelerated via MPV + VA-API hardware decoding"
    echo "  - Interactive launcher provides choice between Firefox ESR and zero-overhead MPV"
    exit 0
fi

# Function: launch YouTube in Firefox ESR
launch_browser() {
    local target="${1:-https://www.youtube.com}"
    if which firefox-esr >/dev/null 2>&1; then
        exec firefox-esr "$target"
    elif which firefox >/dev/null 2>&1; then
        exec firefox "$target"
    elif which chromium >/dev/null 2>&1; then
        exec chromium "$target"
    elif which x-www-browser >/dev/null 2>&1; then
        exec x-www-browser "$target"
    else
        echo "Error: No suitable web browser found." >&2
        exit 1
    fi
}

# Function: launch video via MPV (extremely lightweight: ~40 MB RAM, ~10% CPU)
launch_mpv() {
    local target="$1"
    if which mpv >/dev/null 2>&1; then
        exec mpv --hwdec=auto \
                 --ytdl-format="bestvideo[height<=720]+bestaudio/best[height<=720]" \
                 --cache=yes \
                 --demuxer-max-bytes=32MiB \
                 "$target"
    else
        # Fallback to browser if mpv is not installed
        launch_browser "$target"
    fi
}

# If a direct URL was provided as an argument
if [ -n "$URL" ]; then
    if which mpv >/dev/null 2>&1 && [[ "$URL" == *"youtube.com"* || "$URL" == *"youtu.be"* ]]; then
        launch_mpv "$URL"
    else
        launch_browser "$URL"
    fi
fi

# If launched interactively without URL
if which zenity >/dev/null 2>&1 && [ -n "${DISPLAY:-}" ]; then
    CHOICE=$(zenity --list --radiolist \
        --title="LiteOffice OS — YouTube Hub" \
        --text="Pilih mode pemutaran YouTube untuk Mini PC (2 Core / 2 GB RAM):" \
        --column="Pilih" --column="Mode" --column="Keterangan" \
        TRUE "browser" "Buka YouTube di Web Browser (Firefox ESR)" \
        FALSE "mpv" "Putar Link Video via MPV Player (~40 MB RAM, Sangat Ringan)" \
        --width=540 --height=230 2>/dev/null || echo "browser")

    if [ "$CHOICE" = "browser" ]; then
        launch_browser "https://www.youtube.com"
    elif [ "$CHOICE" = "mpv" ]; then
        VIDEO_URL=$(zenity --entry \
            --title="LiteOffice — Putar YouTube via MPV" \
            --text="Masukkan link video YouTube (contoh: https://youtube.com/watch?v=...):" \
            --width=480 2>/dev/null || echo "")
        if [ -n "$VIDEO_URL" ]; then
            launch_mpv "$VIDEO_URL"
        fi
        exit 0
    fi
fi

# Fallback default
launch_browser "https://www.youtube.com"
