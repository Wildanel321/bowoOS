# ==============================================================================
# Lite Office OS — Tint2 Modern Lightweight Panel Configuration
# Memory Footprint: ~3-5 MB RAM | Flat Modern Aesthetic
# ==============================================================================

# ------------------------------------------------------------------------------
# Backgrounds
# ------------------------------------------------------------------------------
# Background 1: Main Panel
rounded = 0
border_width = 1
border_sides = t
border_color = #2d3340 100
background_color = #181a1f 100

# Background 2: Default / Inactive Task
rounded = 3
border_width = 0
border_sides = b
border_color = #2d3340 0
background_color = #1e222a 0

# Background 3: Active Task
rounded = 3
border_width = 2
border_sides = b
border_color = #3b82f6 100
background_color = #282c34 100

# Background 4: Urgent Task
rounded = 3
border_width = 2
border_sides = b
border_color = #ef4444 100
background_color = #3c1e22 100

# Background 5: Clock & Status Containers
rounded = 3
border_width = 0
background_color = #21252b 100

# ------------------------------------------------------------------------------
# Panel Geometry & Placement
# ------------------------------------------------------------------------------
panel_items = LTS C
panel_size = 100% 32
panel_margin = 0 0
panel_padding = 4 2 4
panel_background_id = 1
wm_menu = 1
panel_dock = 0
panel_pivot_struts = 0
panel_position = bottom center horizontal
panel_layer = top
panel_monitor = all
panel_shrink = 0
autohide = 0
strut_policy = follow_size

# ------------------------------------------------------------------------------
# Taskbar Settings
# ------------------------------------------------------------------------------
taskbar_mode = multi_desktop
taskbar_hide_if_empty = 0
taskbar_padding = 4 0 4
taskbar_background_id = 0
taskbar_active_background_id = 0
taskbar_name = 1
taskbar_hide_inactive_tasks = 0
taskbar_hide_different_monitor = 0
taskbar_always_show_all_desktop_tasks = 0
taskbar_name_padding = 6 2
taskbar_name_background_id = 0
taskbar_name_font = Sans Bold 9
taskbar_name_font_color = #9ca3af 100
taskbar_name_active_font_color = #ffffff 100

# ------------------------------------------------------------------------------
# Task Items
# ------------------------------------------------------------------------------
task_icon = 1
task_text = 1
task_centered = 0
task_maximum_size = 180 28
task_padding = 6 3
task_font = Sans 9
task_tooltip = 1
task_thumbnail = 0
task_font_color = #9ca3af 100
task_active_font_color = #f8fafc 100
task_urgent_font_color = #f87171 100
task_iconified_font_color = #6b7280 100
task_icon_asb = 100 0 0
task_active_icon_asb = 100 0 0
task_urgent_icon_asb = 100 0 0
task_iconified_icon_asb = 70 0 -20
task_background_id = 2
task_active_background_id = 3
task_urgent_background_id = 4
mouse_left = toggle_iconify
mouse_middle = close
mouse_right = close
mouse_scroll_up = prev_task
mouse_scroll_down = next_task

# ------------------------------------------------------------------------------
# System Tray (Systray)
# ------------------------------------------------------------------------------
systray_padding = 6 2 6
systray_background_id = 0
systray_sort = right2left
systray_icon_size = 18
systray_icon_asb = 100 0 0
systray_monitor = 1
systray_name_filter = 

# ------------------------------------------------------------------------------
# Launcher Applet
# ------------------------------------------------------------------------------
launcher_padding = 8 2 8
launcher_background_id = 0
launcher_icon_background_id = 0
launcher_icon_size = 20
launcher_icon_asb = 100 0 0
launcher_icon_theme_override = 0
startup_notifications = 0
launcher_tooltip = 1
# Start Menu button triggers Openbox root menu
launcher_item_app = /usr/share/applications/lite-start-menu.desktop
launcher_item_app = /usr/share/applications/liteoffice-welcome.desktop
launcher_item_app = /usr/share/applications/pcmanfm.desktop
launcher_item_app = /usr/share/applications/liteoffice-control-center.desktop
launcher_item_app = /usr/share/applications/liteoffice-monitor.desktop
launcher_item_app = /usr/share/applications/lxterminal.desktop

# ------------------------------------------------------------------------------
# Clock
# ------------------------------------------------------------------------------
time1_format = %H:%M
time2_format = %a, %d %b
time1_font = Sans Bold 9
time2_font = Sans 8
clock_font_color = #f8fafc 100
clock_padding = 8 2
clock_background_id = 5
clock_tooltip = %A, %B %d, %Y
clock_lclick_command = /usr/local/bin/lite-info
clock_rclick_command = /usr/local/bin/lite-logout

# ------------------------------------------------------------------------------
# Tooltips
# ------------------------------------------------------------------------------
tooltip_padding = 4 4
tooltip_show_timeout = 0.4
tooltip_hide_timeout = 0.2
tooltip_background_id = 1
tooltip_font_color = #f8fafc 100
tooltip_font = Sans 9
