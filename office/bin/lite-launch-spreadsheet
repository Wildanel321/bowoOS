#!/bin/bash
# ==============================================================================
# LiteOffice OS — Adaptive Spreadsheet Launcher
# Launches Gnumeric on <= 512M systems; LibreOffice Calc on >= 1G systems.
# ==============================================================================
set -euo pipefail

TOTAL_RAM_MB=$(awk '/MemTotal/ {print int($2/1024)}' /proc/meminfo 2>/dev/null || echo 512)

# Source detected profile if available
if [ -f /etc/lite-profile ]; then
    . /etc/lite-profile
fi

TIER="${LITE_TIER:-512m}"
PROFILE="${LITE_PROFILE:-lite}"

if [ "$TIER" = "512m" ] || [ "$PROFILE" = "lite" ] || [ "$TOTAL_RAM_MB" -lt 850 ]; then
    if which gnumeric >/dev/null 2>&1; then
        exec gnumeric "$@"
    elif which libreoffice >/dev/null 2>&1; then
        exec libreoffice --calc "$@"
    fi
else
    if which libreoffice >/dev/null 2>&1; then
        exec libreoffice --calc "$@"
    elif which gnumeric >/dev/null 2>&1; then
        exec gnumeric "$@"
    fi
fi

echo "Error: No suitable spreadsheet application found." >&2
exit 1
