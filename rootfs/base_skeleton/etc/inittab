# /etc/inittab: System initialization configuration for Lite Office OS (OpenRC)

# Default runlevel
id:3:initdefault:

# System initialization (OpenRC sysinit & boot)
si::sysinit:/sbin/openrc sysinit
rc::bootrunlevel:/sbin/openrc boot

# Runlevels
l0:0:wait:/sbin/openrc shutdown
l1:1:wait:/sbin/openrc single
l2:2:wait:/sbin/openrc nonetwork
l3:3:wait:/sbin/openrc default
l4:4:wait:/sbin/openrc default
l5:5:wait:/sbin/openrc default
l6:6:wait:/sbin/openrc reboot

# Ctrl-Alt-Del handler
ca:12345:ctrlaltdel:/sbin/reboot

# Virtual Terminals
c1:12345:respawn:/sbin/agetty --noclear 38400 tty1 linux
c2:2345:respawn:/sbin/agetty 38400 tty2 linux
c3:2345:respawn:/sbin/agetty 38400 tty3 linux
c4:2345:respawn:/sbin/agetty 38400 tty4 linux

# Serial Console for debugging and automated testing
s0:12345:respawn:/sbin/agetty -L 115200 ttyS0 vt100
